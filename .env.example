# rig-patterns Environment Configuration
#
# Copy this file to .env and fill in your API keys
# DO NOT commit .env to version control!

# ========================================
# OpenAI Configuration
# ========================================
# Get your API key: https://platform.openai.com/api-keys
# Available models: gpt-4, gpt-4-turbo-preview, gpt-3.5-turbo
OPENAI_API_KEY=sk-...

# ========================================
# Anthropic (Claude) Configuration
# ========================================
# Get your API key: https://console.anthropic.com/
# Available models:
#   - claude-3-opus-20240229 (most capable, highest cost)
#   - claude-3-sonnet-20240229 (balanced performance/cost)
#   - claude-3-haiku-20240307 (fastest, lowest cost)
ANTHROPIC_API_KEY=sk-ant-...

# ========================================
# Cohere Configuration
# ========================================
# Get your API key: https://dashboard.cohere.com/api-keys
# Available models: command, command-light, command-nightly
COHERE_API_KEY=...

# ========================================
# Optional: Logging Configuration
# ========================================
# Set log level (trace, debug, info, warn, error)
RUST_LOG=info

# ========================================
# UI Server Configuration (for rig-patterns-ui)
# ========================================
# Server port (default: 3000)
# SERVER_PORT=3000

# Enable real LLM execution in UI (default: false, uses mock)
# ENABLE_REAL_LLMS=true
